NODE_ENV=development
HOST=127.0.0.1
PORT=5000
CLIENT_ORIGIN=http://127.0.0.1:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hrcms_app
DB_PASSWORD=replace-with-your-mysql-password
DB_NAME=hrcms
JWT_SECRET=replace-with-at-least-32-random-characters
# Only used by db:setup; defaults to DB_USER / DB_PASSWORD when omitted.
# DB_ADMIN_USER=root
# DB_ADMIN_PASSWORD=your-root-password
# Optional MySQL account host for a remote/container server; local setup defaults
# to separate localhost and 127.0.0.1 accounts.
# DB_APP_HOST=your-application-host
